# Copy this file to `.env` and fill in real values before running
# `docker compose up -d`. Never commit your real `.env` file.
# See docs/SECURITY.md for guidance on generating/rotating API keys and
# putting this service behind TLS.

# --- Server ---------------------------------------------------------------
AMBIENT_NOTES_PORT=8080
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
REQUIRE_TLS=true

# Comma-separated list of API keys the Android app must send as
# `Authorization: Bearer <key>`. Generate with: openssl rand -hex 32
API_KEYS=replace-with-a-long-random-string

# --- Provider chain ---------------------------------------------------------
# Ordered, comma-separated. Add/remove names to change fallback behavior
# without touching code. Built-in names: dejavu, ollama, acrcloud, audd,
# selfhosted_peer (auto-added per PEER_SERVICE_URLS entry).
PROVIDER_CHAIN=dejavu,ollama
MIN_CONFIDENCE=0.55
MAX_AUDIO_SECONDS=20

# --- Dejavu (local fingerprinting DB) ---------------------------------------
DEJAVU_DB_HOST=dejavu-db
DEJAVU_DB_PORT=3306
DEJAVU_DB_NAME=dejavu
DEJAVU_DB_USER=dejavu
DEJAVU_DB_PASSWORD=changeme
DEJAVU_DB_ROOT_PASSWORD=changeme_root

# --- Ollama (local LLM assist / re-ranking) ---------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# --- ACRCloud (optional operator-owned cloud fallback) ----------------------
ACRCLOUD_ENABLED=false
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# --- AudD (optional operator-owned cloud fallback) --------------------------
AUDD_ENABLED=false
AUDD_API_TOKEN=

# --- Peer AmbientNotesService instances (optional federation) ---------------
PEER_SERVICE_URLS=
